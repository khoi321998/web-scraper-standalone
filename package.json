{
    "name": "actor-puppeteer-scraper",
    "version": "3.1.0",
    "private": true,
    "type": "module",
    "description": "Crawl web pages using Apify, headless Chrome and Puppeteer",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@apify/scraper-tools": "^1.1.4",
        "@crawlee/puppeteer": "^3.16.0",
        "apify": "^3.7.1",
        "idcac-playwright": "^0.2.0",
        "puppeteer": "25.3.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.58.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "license": "Apache-2.0"
}
